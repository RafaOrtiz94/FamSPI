https://spi-dev.fam-project.com {
	# Generate self-signed certificates for local development
	tls internal

	# WebSocket routes - return 404 (not implemented)
	handle /ws* {
		respond 404
	}

	# API routes - must be handled BEFORE SPA fallback
	handle /api/* {
		# Node.js backend runs on 192.168.0.161:3000 (different host than Caddy)
		reverse_proxy http://192.168.0.161:3000 {
			# Debug: Add backend identification header
			header_up X-Forwarded-By "Caddy-Reverse-Proxy"
		}
	}

	# SPA fallback - serves static files and handles client-side routing
	handle {
		root * spi_front/build
		try_files {path} {path}/ /index.html
		file_server
	}
}

# Desarrollo local con build - IP de red (HTTPS)
https://192.168.0.161 {
	# Certificado interno para uso en red local
	tls internal

	# WebSocket routes - return 404 (not implemented)
	handle /ws* {
		respond 404
	}

	# API routes - must be handled BEFORE SPA fallback
	handle /api/* {
		# Node.js backend runs on192.168.100.171:3000
		reverse_proxy http://192.168.0.161:3000 {
			# Debug: Add backend identification header
			header_up X-Forwarded-By "Caddy-Reverse-Proxy"
		}
	}

	# SPA fallback - serves static files and handles client-side routing
	handle {
		root * spi_front/build
		try_files {path} {path}/ /index.html
		file_server
	}
}

# Redirect HTTP to HTTPS
http://spi-dev.fam-project.com {
	redir https://{host}{uri} permanent
}

# Redirect HTTP to HTTPS (IP de red)
http://192.168.0.161 {
	redir https://{host}{uri} permanent
}

# Desarrollo local con build - localhost (Caddy en puerto 8080, backend en 3000)
http://localhost:8080 {
	# WebSocket routes - return 404 (not implemented)
	handle /ws* {
		respond 404
	}

	# API routes - must be handled BEFORE SPA fallback
	handle /api/* {
		# Node.js backend runs on localhost:3000
		reverse_proxy http://localhost:3000 {
			# Debug: Add backend identification header
			header_up X-Forwarded-By "Caddy-Reverse-Proxy"
		}
	}

	# SPA fallback - serves static files and handles client-side routing
	handle {
		root * spi_front/build
		try_files {path} {path}/ /index.html
		file_server
	}
}

