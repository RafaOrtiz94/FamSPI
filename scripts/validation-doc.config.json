                                                     "definitions":  [
                                                                         {
                                                                             "term":  "OAuth 2.0",
                                                                             "definition":  "Mecanismo de federacion usado por SPI para autenticar usuarios internos mediante Google."
                                                                         },
                                                                         {
                                                                             "term":  "JWT",
                                                                             "definition":  "Token firmado que representa la sesion autenticada del usuario frente al backend."
                                                                         },
                                                                         {
                                                                             "term":  "Refresh Token",
                                                                             "definition":  "Credencial usada para renovar un access token vigente sobre una sesion activa registrada."
                                                                         },
                                                                         {
                                                                             "term":  "RBAC",
                                                                             "definition":  "Control de acceso basado en roles aplicado por middlewares y validaciones de modulo."
                                                                         },
                                                                         {
                                                                             "term":  "LOPDP",
                                                                             "definition":  "Marco regulatorio de proteccion de datos personales considerado en el flujo de aceptacion interna del sistema."
                                                                         },
                                                                         {
                                                                             "term":  "Audit Trail",
                                                                             "definition":  "Trazabilidad tecnica o funcional de eventos relevantes registrados por los modulos del area."
                                                                         },
                                                                         {
                                                                             "term":  "Off-hours login",
                                                                             "definition":  "Evento de inicio de sesion detectado fuera del horario esperado y tratado como evento de seguridad."
                                                                         },
                                                                         {
                                                                             "term":  "Bitacora de auditoria",
                                                                             "definition":  "Registro transversal de eventos del sistema consultable por roles autorizados."
                                                                         },
                                                                         {
                                                                             "term":  "Firma avanzada",
                                                                             "definition":  "Proceso de firma documental con hash, sello, QR y evidencia tecnica asociada."
                                                                         },
                                                                         {
                                                                             "term":  "Token de verificacion",
                                                                             "definition":  "Identificador publico para consultar la validez de un documento firmado."
                                                                         },
                                                                         {
                                                                             "term":  "IQ",
                                                                             "definition":  "Calificacion de instalacion que verifica que los componentes requeridos esten desplegados y disponibles."
                                                                         },
                                                                         {
                                                                             "term":  "OQ",
                                                                             "definition":  "Calificacion de operacion que valida el funcionamiento esperado bajo condiciones normales y de error."
                                                                         },
                                                                         {
                                                                             "term":  "PQ",
                                                                             "definition":  "Calificacion de desempeno que verifica consistencia del sistema en su contexto de uso real."
                                                                         },
                                                                         {
                                                                             "term":  "RTM",
                                                                             "definition":  "Matriz de trazabilidad entre requerimientos, especificaciones, diseno y pruebas."
                                                                         }
